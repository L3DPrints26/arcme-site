# Netlify's default edge cache holds JSON for up to a year, which is exactly
# wrong for a file whose entire job is being re-read every few seconds to
# notice a new build. Every other asset is fine to cache hard — its filename
# changes whenever its content does, so an old cached copy is never wrong,
# just eventually unused. version.json is the one file that has to stay
# fresh under the same name.
/version.json
  Cache-Control: no-store

# index.html names which bundle to load, so a cached copy pins a phone to an
# old build no matter how many times it's deployed. Its own filename never
# changes, so it must always be revalidated — the assets it points at are
# content-hashed and can be cached hard forever.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
